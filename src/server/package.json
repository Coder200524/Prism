{
  "name": "@dogfood/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/index.ts",
    "prisma": "prisma"
  },
  "dependencies": {
    "@dogfood/shared": "*",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.0",
    "prisma": "^6.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
